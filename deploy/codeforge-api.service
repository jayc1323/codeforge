[Unit]
Description=CodeForge API (.NET 8, published binary)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/codeforge-api
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://localhost:5045
EnvironmentFile=/root/codeforge/.secrets/env
ExecStart=/usr/local/dotnet/dotnet /opt/codeforge-api/CodeForge.Api.dll
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
